{
  "id": "example-glass",
  "name": "Example Glass",
  "version": "2.0.0",
  "author": "talkative",
  "licence": "CC0-1.0",
  "description": "A small example: cool glass panels in dark and light, and two soft notification sounds. Copy this folder to start a package of your own.",
  "talkative": ">=0.7",
  "contents": {
    "themes": {
      "glass": {
        "name": "Glass",
        "modes": ["dark", "light"],
        "colors": ["#3a9fe0", "#0b1a2a", "#eaf6ff", "#34b36a"]
      }
    },
    "sounds": {
      "soft": {
        "name": "Soft",
        "sounds": {
          "mention": "chime.ogg",
          "direct-message": "chime.ogg",
          "message-sent": "tap.ogg"
        }
      }
    }
  },
  "previews": []
}
